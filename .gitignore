# Build output dashboard (dibangun ulang via `cd web && npm run build`)
web/dist/*
!web/dist/.gitkeep

# Dependensi dan artefak lokal web
web/node_modules/
web/test-results/
web/playwright-report/
web/tsconfig.tsbuildinfo
web/coverage/

# Konfigurasi lokal — tidak pernah masuk repo
.env
*.env
*.local

# State sesi e2e (berisi cookie + token CSRF staging, dibuat ulang tiap run)
web/e2e/.auth-*.json

# Biner kompilasi Go
/ai-gateway
/ai-gateway-*

# Config Xray hasil generate runtime (berisi kredensial acak per-instalasi).
# Docker Compose mengekspos ./deploy/xray ke container gateway & xray sekaligus;
# config.runtime.json ditulis gateway & dibaca xray, jangan di-commit.
deploy/xray/config.runtime.json
