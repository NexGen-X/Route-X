# ==============================================================================
# Route-X — Production Caddyfile (Otomatis TLS / HTTPS dengan Let's Encrypt)
# ==============================================================================

{$PUBLIC_DOMAIN:localhost} {
    # Logging akses terstruktur JSON
    log {
        output stdout
        format json
    }

    # Kompresi gzip dan zstd untuk aset statis dan respon JSON non-streaming
    encode zstd gzip

    # Header keamanan pelengkap
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Reverse proxy ke container atau service Route-X
    # Catatan: flush_interval -1 KRITIS untuk streaming Server-Sent Events (SSE),
    # agar potongan token teks langsung diteruskan ke klien tanpa buffer Caddy.
    reverse_proxy gateway:8080 {
        flush_interval -1
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
