# ==============================================================================
# Route-X Environment Configuration (.env.example)
# Arsitektur 4 Layanan: Route-X Core, PostgreSQL, Redis, Caddy
# ==============================================================================

# --- Pengaturan Umum Aplikasi ---
APP_ENV=production
PORT=8080
# PUBLIC_URL wajib skema https saat APP_ENV=production (validasi config menolak boot).
# Ganti dengan domain Anda: https://gateway.contoh.com. Saat menjalankan bash deploy.sh
# tanpa domain, host diisi otomatis dari alamat publik utama server.
PUBLIC_URL=https://localhost

# --- PostgreSQL Database ---
POSTGRES_USER=routex
POSTGRES_PASSWORD=
POSTGRES_DB=routex_prod
DATABASE_URL=postgres://routex:${POSTGRES_PASSWORD}@db:5432/routex_prod?sslmode=require

# --- Redis In-Memory Cache & Rate Limiting ---
REDIS_URL=redis://redis:6379/0

# --- Kunci Enkripsi & Keamanan ---
# ENCRYPTION_KEY & API_KEY_PEPPER wajib base64 yang didekode 32 byte
# (openssl rand -base64 32). Nilai heksadesimal 64 karakter didekode menjadi 48
# byte dan menyebabkan gateway menolak boot. SESSION_SECRET minimal 32 karakter.
# Tip: Saat menjalankan bash deploy.sh, kunci ini otomatis dihasilkan via openssl
SESSION_SECRET=
ENCRYPTION_KEY=
# ENCRYPTION_KEY_PREVIOUS: kunci LAMA selama masa tenggang rotasi
# ENCRYPTION_KEY (gateway membaca ciphertext lama + baru, menulis dengan
# kunci aktif). Kosongkan di luar masa rotasi — lihat docs/runbook-operasi.md §4.
ENCRYPTION_KEY_PREVIOUS=
API_KEY_PEPPER=
# SESSION_TTL: masa berlaku sesi sejak aktivitas terakhir (kedaluwarsa geser;
# batas mutlak 7 hari dari pembuatan). Bawaan 12 jam; rentang sah 5m s/d 168h.
SESSION_TTL=
# BUDGET_TIMEZONE: zona waktu operator (nama IANA, mis. Asia/Makassar) untuk
# batas kalender periode anggaran weekly/monthly — reset jatuh pada Senin
# 00:00 / tanggal 1 00:00 di zona ini. Bawaan UTC (perilaku historis). Nama
# yang tidak sah membuat gateway MENOLAK boot, bukan jatuh diam-diam ke UTC.
# Periode daily tidak terpengaruh: ia 24 jam bergulir, bukan batas kalender.
BUDGET_TIMEZONE=

# WAJIB diisi dengan password kuat pilihan Anda agar akun admin pertama dibuat.
# Kosong = tidak ada admin yang dibuat. TIDAK ada password default.
# deploy.sh dan installer resmi mengisinya dengan nilai acak unik.
# --- Kredensial Administrator Awal (First-Run Onboarding) ---
INITIAL_ADMIN_EMAIL=admin@routex.local
INITIAL_ADMIN_PASSWORD=

# --- Telemetri & Keamanan Jaringan ---
METRICS_TOKEN=
# AUDIT FIX: jangan pakai 0.0.0.0/0 — semua client bisa spoof X-Forwarded-For.
# Isi dengan CIDR proxy tepercaya Anda. docker-compose.yml repo ini memakai
# subnet terpaku 172.30.0.0/16 sebagai bawaannya; installer native memakai
# loopback 127.0.0.1,::1 karena Caddy berjalan di host yang sama.
TRUSTED_PROXIES=

# --- Batas Waktu Server (opsional; kosong = bawaan kode) ---
# Makna 0 TIDAK seragam, hati-hati (audit3 V-LN-21):
# READ_TIMEOUT/WRITE_TIMEOUT: 0s berarti TANPA batas (dihormati apa adanya).
# SHUTDOWN_GRACE: 0s DIABAIKAN dan diganti bawaan 25 detik (tercatat sebagai
# peringatan di log startup). UPSTREAM_TIMEOUT adalah batas waktu bawaan
# request ke provider bila kandidat rute tidak menentukan timeout sendiri.
READ_TIMEOUT=
WRITE_TIMEOUT=
SHUTDOWN_GRACE=
UPSTREAM_TIMEOUT=

# --- OAuth Upstream (Google Antigravity) ---
# Client secret untuk client ID publik Antigravity. WAJIB disetel agar
# koneksi & refresh akun Antigravity berfungsi — tidak ada nilai bawaan yang
# tertanam di biner. Kosongkan bila tidak memakai integrasi Antigravity.
ANTIGRAVITY_CLIENT_SECRET=

# --- Izinkan Jalur Egress Privat (Reverse Proxy Internal & Loopback) ---
# Hostname/ subnet di sini dikecualikan dari blokir SSRF keluar gateway.
# Hanya tambahkan yang benar-benar Anda kelola dan percaya.
UPSTREAM_ALLOWED_PRIVATE_ADDRS=127.0.0.1,::1,127.0.0.0/8
# UPSTREAM_ALLOW_HTTP: izinkan base_url provider http:// (bawaan false —
# egress publik wajib https). Hanya untuk upstream tepercaya di jaringan privat.
UPSTREAM_ALLOW_HTTP=

# --- Pengaturan Lanjutan (opsional; kosong = bawaan kode di internal/config/config.go) ---
# LOG_LEVEL: debug | info | warn | error (bawaan info).
LOG_LEVEL=
# Pool koneksi database (bawaan DB_MAX_CONNS=25, DB_MIN_CONNS=8).
DB_MAX_CONNS=
DB_MIN_CONNS=
# MAX_REQUEST_MIB: batas ukuran badan request klien dalam MiB (bawaan 10).
MAX_REQUEST_MIB=
# RATE_LIMIT_FAIL_CLOSED: true = permintaan ditolak saat Redis tak terjangkau;
# false (bawaan) = fail-open, permintaan tetap dilayani tanpa penegakan limiter.
RATE_LIMIT_FAIL_CLOSED=
# METRICS_ALLOW_LOOPBACK: akses /metrics dari loopback tanpa token.
# Bawaan: menyala di non-produksi, mati di produksi.
METRICS_ALLOW_LOOPBACK=
# Interval pemeriksaan kesehatan provider & rollup pemakaian (bawaan 60s / 5m).
HEALTH_CHECK_INTERVAL=
USAGE_ROLLUP_INTERVAL=
# Retensi data (hari): baris requests (bawaan 30), payload request (bawaan 7),
# log audit (bawaan 365). Lihat docs/runbook-operasi.md §3.
REQUEST_LOG_RETENTION_DAYS=
REQUEST_BODY_RETENTION_DAYS=
AUDIT_LOG_RETENTION_DAYS=
