# ==============================================================================
# Route-X — Templat Konfigurasi Lingkungan untuk Koyeb + Neon + Upstash
# ==============================================================================
# Salin dan isi variabel berikut ke tab "Environment variables" di Koyeb Dashboard.
# ==============================================================================

# Mode Operasional
APP_ENV=production
LOG_LEVEL=info
PORT=8080

# URL Layanan Koyeb Anda (Wajib HTTPS di production)
# Contoh: https://route-x-username.koyeb.app
PUBLIC_URL=https://route-x-yourname.koyeb.app

# 1. Basis Data PostgreSQL Gratis dari Neon.tech
# Buat akun di https://neon.tech -> Buat Project -> Salin Connection String (Pooled atau Direct)
# Wajib menyertakan sslmode=require
DATABASE_URL=postgres://neondb_owner:password@ep-xyz-123.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# 2. Redis Cache & Rate Limiting Gratis dari Upstash.com
# Buat akun di https://upstash.com -> Buat Redis Database -> Salin "UPSTASH_REDIS_REST_URL" atau standard Redis URL
# Format: redis://default:password@endpoint.upstash.io:6379
REDIS_URL=redis://default:your_upstash_password@your_endpoint.upstash.io:6379

# 3. Kunci Kriptografi & Sesi
# Hasilkan nilai acak yang aman dengan menjalankan: bash scripts/ops/generate-secrets.sh
SESSION_SECRET=<generate_via_scripts/ops/generate-secrets.sh>
ENCRYPTION_KEY=<generate_via_scripts/ops/generate-secrets.sh>
API_KEY_PEPPER=<generate_via_scripts/ops/generate-secrets.sh>

# 4. Akun Administrator Awal (Dibuat otomatis saat startup pertama kali)
INITIAL_ADMIN_EMAIL=admin@id-tech.cloud
INITIAL_ADMIN_PASSWORD=<GANTI_PASSWORD_MIN_16_KARAKTER>

# 5. Keamanan & Metrik
METRICS_TOKEN=token_scraper_panjang_minimal_32_karakter
METRICS_ALLOW_LOOPBACK=false
RATE_LIMIT_FAIL_CLOSED=false
