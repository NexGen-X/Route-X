# ==============================================================================
# Route-X — Docker Compose Environment Variables
# ==============================================================================

APP_ENV=production
PORT=8080
LOG_LEVEL=info

# Database PostgreSQL
POSTGRES_USER=routex
POSTGRES_PASSWORD=
POSTGRES_DB=routex
DB_SSLMODE=require

# Rahasia Kriptografis (Wajib diisi nilai acak di lingkungan produksi)
# Jalankan: openssl rand -base64 48
SESSION_SECRET=
# Jalankan: openssl rand -base64 32
ENCRYPTION_KEY=
# Jalankan: openssl rand -base64 32
API_KEY_PEPPER=

# Akun Administrator Awal (Wajib diganti saat login pertama)
INITIAL_ADMIN_EMAIL=admin@routex.internal
INITIAL_ADMIN_PASSWORD=

# Domain Publik dan URL (Untuk Caddy Reverse Proxy TLS & Validasi Produksi)
PUBLIC_DOMAIN=gateway.example.com
PUBLIC_URL=https://gateway.example.com
