# Build output dashboard (dibangun ulang via `cd web && npm run build`)
web/dist/*
!web/dist/.gitkeep

# Dependensi dan artefak lokal web
web/node_modules/
web/test-results/
web/playwright-report/
web/tsconfig.tsbuildinfo
web/coverage/

# Konfigurasi lokal — tidak pernah masuk repo
.env
*.env
*.local

# State sesi e2e (berisi cookie + token CSRF staging, dibuat ulang tiap run)
web/e2e/.auth-*.json

# Biner kompilasi Go
/ai-gateway
/ai-gateway-*



# Artefak knowledge graph codebase-memory (cache yang dibangun ulang via re-index)
.codebase-memory/

# File scratch dan backup lokal
NEXT_STEPS.md
*.sql.backup
routing_rules_backup_*.sql
scripts/typesafe_jev.py
