# ==============================================================================
# Route-X Environment Configuration (.env.example)
# Arsitektur 5 Layanan: Route-X Core, PostgreSQL, Redis, Xray, Caddy
# ==============================================================================

# --- Pengaturan Umum Aplikasi ---
APP_ENV=production
PORT=8080
PUBLIC_URL=http://localhost:8080

# --- PostgreSQL Database ---
POSTGRES_USER=routex
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_ANDA
POSTGRES_DB=routex_prod
DATABASE_URL=postgres://routex:${POSTGRES_PASSWORD}@db:5432/routex_prod?sslmode=prefer

# --- Redis In-Memory Cache & Rate Limiting ---
REDIS_URL=redis://redis:6379/0

# --- Kunci Enkripsi & Keamanan (Wajib 32-byte hex string / 64 karakter) ---
# Tip: Saat menjalankan bash deploy.sh, kunci ini otomatis dihasilkan via openssl
SESSION_SECRET=
ENCRYPTION_KEY=
API_KEY_PEPPER=

# --- Kredensial Administrator Awal (First-Run Onboarding) ---
INITIAL_ADMIN_EMAIL=admin@routex.local
INITIAL_ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_ADMIN_ANDA

# --- Telemetri & Keamanan Jaringan ---
METRICS_TOKEN=
TRUSTED_PROXIES=0.0.0.0/0

# --- Izinkan Jalur Egress Privat untuk Container Xray ---
UPSTREAM_ALLOWED_PRIVATE_ADDRS=xray,127.0.0.1,::1,127.0.0.0/8,172.16.0.0/12
