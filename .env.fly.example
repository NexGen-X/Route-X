# ==============================================================================
# Route-X — Templat Variabel Lingkungan untuk Fly.io
# ==============================================================================
# Di Fly.io, variabel rahasia disetel menggunakan perintah:
#   fly secrets set KUNCI=NILAI
# Atau gunakan skrip otomatis:
#   bash scripts/ops/fly-set-secrets.sh
# ==============================================================================

# Mode Operasional
APP_ENV=production
LOG_LEVEL=info
PORT=8080

# URL Layanan Fly.io Anda (Wajib HTTPS di production)
# Contoh: https://route-x.fly.dev
PUBLIC_URL=https://route-x.fly.dev

# 1. PostgreSQL (Bisa dari 'fly postgres attach' atau Neon.tech)
# Wajib menyertakan sslmode=require jika dari provider luar (Neon/Supabase)
DATABASE_URL=postgres://user:password@host:5432/routex_prod?sslmode=require
DB_MAX_CONNS=15
DB_MIN_CONNS=2

# 2. Redis (Bisa dari 'fly redis create' atau Upstash.com)
REDIS_URL=redis://default:password@host:6379

# 3. Kunci Kriptografi & Sesi (Disetel lewat fly secrets set)
# Jalankan: bash scripts/ops/generate-secrets.sh
SESSION_SECRET=<generate_via_scripts/ops/generate-secrets.sh>
ENCRYPTION_KEY=<generate_via_scripts/ops/generate-secrets.sh>
API_KEY_PEPPER=<generate_via_scripts/ops/generate-secrets.sh>

# 4. Akun Administrator Awal (Didaftarkan otomatis saat startup pertama kali)
INITIAL_ADMIN_EMAIL=admin@id-tech.cloud
INITIAL_ADMIN_PASSWORD=<GANTI_PASSWORD_MIN_16_KARAKTER>

# 5. Keamanan & Metrik
METRICS_TOKEN=token_scraper_panjang_minimal_32_karakter
METRICS_ALLOW_LOOPBACK=false
RATE_LIMIT_FAIL_CLOSED=false
