# ==============================================================================
# Route-X — Templat Variabel Lingkungan untuk Fly.io
# ==============================================================================
# Di Fly.io, variabel rahasia disetel menggunakan perintah:
#   fly secrets set KUNCI=NILAI
# Atau gunakan skrip otomatis:
#   bash scripts/ops/fly-set-secrets.sh <nama-aplikasi>
# Daftar ini sinkron dengan env yang dibaca internal/config/config.go.
# Nilai <...> adalah placeholder — jangan pakai apa adanya.
# ==============================================================================

# Mode Operasional
APP_ENV=production
LOG_LEVEL=info
PORT=8080

# URL Layanan Fly.io Anda (Wajib HTTPS di production)
# Contoh: https://route-x.fly.dev
PUBLIC_URL=https://route-x.fly.dev

# 1. PostgreSQL (Bisa dari 'fly postgres attach' atau Neon.tech)
# Wajib menyertakan sslmode=require jika dari provider luar (Neon/Supabase)
DATABASE_URL=postgres://user:password@host:5432/routex_prod?sslmode=require
DB_MAX_CONNS=15
DB_MIN_CONNS=2

# 2. Redis (Bisa dari 'fly redis create' atau Upstash.com)
REDIS_URL=redis://default:password@host:6379

# 3. Kunci Kriptografi & Sesi (Disetel lewat fly secrets set)
# Hasilkan dengan: bash scripts/ops/generate-secrets.sh
# SESSION_SECRET min 32 karakter; ENCRYPTION_KEY base64 tepat 32 byte;
# API_KEY_PEPPER base64 min 32 byte.
SESSION_SECRET=<placeholder-hasilkan-sendiri>
ENCRYPTION_KEY=<placeholder-hasilkan-sendiri>
# ENCRYPTION_KEY_PREVIOUS: hanya selama masa tenggang rotasi ENCRYPTION_KEY
# (lihat docs/runbook-operasi.md §4). Kosongkan di luar masa rotasi.
ENCRYPTION_KEY_PREVIOUS=
API_KEY_PEPPER=<placeholder-hasilkan-sendiri>
# SESSION_TTL: masa berlaku sesi (kedaluwarsa geser), bawaan 12 jam,
# rentang sah 5m s/d 168h; batas mutlak sesi 7 hari selalu berlaku.
SESSION_TTL=

# 4. Akun Administrator Awal (Dibuat otomatis saat startup pertama kali)
# INITIAL_ADMIN_PASSWORD wajib terisi agar admin pertama dibuat —
# TIDAK ada password default.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=<GANTI_DENGAN_PASSWORD_KUAT_PILIHAN_ANDA>

# 5. Keamanan & Metrik
METRICS_TOKEN=<placeholder-min-32-karakter>
METRICS_ALLOW_LOOPBACK=false
RATE_LIMIT_FAIL_CLOSED=false
# TRUSTED_PROXIES: CIDR proxy tepercaya di depan aplikasi. Di Fly, edge
# Fly yang meneruskan X-Forwarded-For; kosongkan bila tidak yakin —
# jangan pernah 0.0.0.0/0 (semua klien bisa memalsukan X-Forwarded-For).
TRUSTED_PROXIES=

# 6. Batas Waktu & Perilaku Upstream (opsional; kosong = bawaan kode)
# UPSTREAM_TIMEOUT bawaan 120s; READ_TIMEOUT 30s; WRITE_TIMEOUT 5m;
# SHUTDOWN_GRACE 25s. Makna 0 TIDAK seragam antar-knob — lihat .env.example.
UPSTREAM_TIMEOUT=
READ_TIMEOUT=
WRITE_TIMEOUT=
SHUTDOWN_GRACE=
# BUDGET_TIMEZONE: zona IANA batas kalender periode anggaran weekly/monthly
# (bawaan UTC). Nama tak sah membuat gateway menolak boot.
BUDGET_TIMEZONE=
# MAX_REQUEST_MIB: batas ukuran badan request klien (bawaan 10).
MAX_REQUEST_MIB=

# 7. OAuth Upstream (Google Antigravity)
# WAJIB hanya bila memakai integrasi Antigravity: dibaca dari environment
# saja, tidak ada nilai tertanam di biner. Kosongkan bila tidak memakai.
ANTIGRAVITY_CLIENT_SECRET=<placeholder-isi-bila-memakai-antigravity>

# 8. Retensi & Interval (opsional; kosong = bawaan kode)
# REQUEST_LOG_RETENTION_DAYS=30, REQUEST_BODY_RETENTION_DAYS=7,
# AUDIT_LOG_RETENTION_DAYS=365, HEALTH_CHECK_INTERVAL=60s,
# USAGE_ROLLUP_INTERVAL=5m.
REQUEST_LOG_RETENTION_DAYS=
REQUEST_BODY_RETENTION_DAYS=
AUDIT_LOG_RETENTION_DAYS=
HEALTH_CHECK_INTERVAL=
USAGE_ROLLUP_INTERVAL=
