# ============================================================
# Route-X — contoh konfigurasi. Salin ke .env lalu isi.
#   cp .env.example .env
# Semua rahasia HARUS di-generate sendiri, jangan pakai nilai contoh.
# ============================================================

# --- Aplikasi ---------------------------------------------------------------
APP_ENV=development          # development | staging | production
PORT=8080
LOG_LEVEL=info               # debug | info | warn | error
# URL publik gateway, dipakai untuk cookie domain & link di dashboard.
# PUBLIC_URL=https://gateway.example.com

# --- PostgreSQL ------------------------------------------------------------
DATABASE_URL=postgres://routex:PASSWORD@127.0.0.1:5432/routex?sslmode=disable
# DB_MAX_CONNS=20
# DB_MIN_CONNS=2

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# --- Rahasia (WAJIB, aplikasi menolak start kalau lemah/kosong) ------------
# Kunci sesi admin        -> openssl rand -base64 48
SESSION_SECRET=
# Kunci enkripsi kredensial provider, AES-256-GCM, tepat 32 byte
#                         -> openssl rand -base64 32
ENCRYPTION_KEY=
# Pepper untuk HMAC hash API key -> openssl rand -base64 32
API_KEY_PEPPER=

# --- Admin pertama (di-seed saat start pertama) ----------------------------
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=
# Ganti password ini segera setelah login pertama.

# --- Batas & timeout -------------------------------------------------------
# MAX_REQUEST_BYTES=10485760      # 10 MiB
# UPSTREAM_TIMEOUT=120s
# SHUTDOWN_GRACE=25s

# --- Retensi data ----------------------------------------------------------
# REQUEST_LOG_RETENTION_DAYS=30
# REQUEST_BODY_RETENTION_DAYS=7

# --- Worker ----------------------------------------------------------------
# HEALTH_CHECK_INTERVAL=60s
# USAGE_ROLLUP_INTERVAL=5m
