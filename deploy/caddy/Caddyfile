# ==============================================================================
# Route-X — Caddyfile Reverse Proxy dengan Automatic TLS / On-Demand HTTPS
# ==============================================================================

{
    admin 0.0.0.0:2019
    on_demand_tls {
        ask http://gateway:8080/api/internal/tls-check
    }
}

https:// {
    tls {
        on_demand
    }

    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # 1. Jalur VLESS WebSocket Tersembunyi (Stealth Tunnel)
    @xray_ws {
        path /routex-xray-ws*
    }
    reverse_proxy @xray_ws xray:10001

    # 2. Jalur VLESS gRPC Tersembunyi
    @xray_grpc {
        path /routex-grpc/*
    }
    reverse_proxy @xray_grpc xray:10002 {
        transport http {
            versions h2c
        }
    }

    # 3. Jalur Trojan WebSocket Tersembunyi
    @trojan_ws {
        path /routex-trojan-ws*
    }
    reverse_proxy @trojan_ws xray:10003

    # 4. Jalur Trojan gRPC Tersembunyi
    @trojan_grpc {
        path /routex-trojan-grpc/*
    }
    reverse_proxy @trojan_grpc xray:10004 {
        transport http {
            versions h2c
        }
    }

    # 5. Jalur VMess WebSocket Tersembunyi
    @vmess_ws {
        path /routex-vmess-ws*
    }
    reverse_proxy @vmess_ws xray:10005

    # 6. Jalur VMess gRPC Tersembunyi
    @vmess_grpc {
        path /routex-vmess-grpc/*
    }
    reverse_proxy @vmess_grpc xray:10006 {
        transport http {
            versions h2c
        }
    }

    # 7. Jalur Shadowsocks WebSocket Tersembunyi
    @ss_ws {
        path /routex-ss-ws*
    }
    reverse_proxy @ss_ws xray:10007

    # 8. Jalur VLESS SplitHTTP / XHTTP Tersembunyi
    @xray_xhttp {
        path /routex-xhttp*
    }
    reverse_proxy @xray_xhttp xray:10008

    # 4. Route-X Gateway & Web Dashboard
    reverse_proxy gateway:8080 {
        flush_interval -1
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto https
    }
}

http:// {
    @isDomain header_regexp host Host ^([a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}(:\d+)?$
    redir @isDomain https://{host}{uri} permanent

    reverse_proxy gateway:8080 {
        flush_interval -1
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto http
    }
}
