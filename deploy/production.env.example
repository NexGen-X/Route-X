# ==============================================================================
# Route-X — Templat Konfigurasi Lingkungan Produksi (/etc/route-x/route-x.env)
# ==============================================================================
# PERHATIAN KEAMANAN:
# Seluruh nilai rahasia di bawah wajib dibuat secara acak dan mandiri oleh operator.
# JANGAN PERNAH menyalin berkas konfigurasi development (.env) ke lingkungan produksi!
# ==============================================================================

# --- Lingkungan Aplikasi ------------------------------------------------------
APP_ENV=production
PORT=8080
LOG_LEVEL=info

# URL publik gateway. Di lingkungan produksi, nilai ini WAJIB berawalan https://
# dan digunakan untuk domain cookie keamanan (__Host-), CSRF, serta tautan portal.
PUBLIC_URL=https://gateway.example.com

# --- Basis Data PostgreSQL ----------------------------------------------------
# CATATAN ARSITEKTUR JALUR DEPLOY:
# 1. Jalur Systemd / Bare-Metal: Menggunakan variabel DATABASE_URL langsung di bawah.
#    Pada APP_ENV=production, ?sslmode=disable DILARANG KERAS oleh sistem (wajib sslmode=require/verify-ca/verify-full).
# 2. Jalur Docker Compose: Mengabaikan DATABASE_URL mentah ini dan merakitnya otomatis dari
#    POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB, dan DB_SSLMODE.
DATABASE_URL=postgres://routex:GANTI_DENGAN_PASSWORD_DATABASE_KUAT@127.0.0.1:5432/routex?sslmode=require
DB_SSLMODE=require
POSTGRES_USER=routex
POSTGRES_PASSWORD=
POSTGRES_DB=routex
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# --- Redis Cache & Rate Limiting ----------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# --- Rahasia Kriptografis (WAJIB DI-GENERATE SENDIRI) --------------------------
# Kunci sesi web admin (minimal 32 byte base64).
# Perintah pembuatan: openssl rand -base64 48
SESSION_SECRET=

# Kunci enkripsi kredensial provider upstream (AES-256-GCM, tepat 32 byte base64).
# Perintah pembuatan: openssl rand -base64 32
ENCRYPTION_KEY=

# Kunci pepper HMAC-SHA256 untuk hashing API key klien (tepat 32 byte base64).
# Perintah pembuatan: openssl rand -base64 32
API_KEY_PEPPER=

# --- Kredensial Administrator Awal --------------------------------------------
# Di-seed saat pertama kali database diinisialisasi.
INITIAL_ADMIN_EMAIL=admin@example.com

# Kata sandi admin awal. Pada APP_ENV=production, wajib minimal 16 karakter.
# Wajib segera diubah saat login pertama kali.
INITIAL_ADMIN_PASSWORD=

# --- Batas & Batas Waktu ------------------------------------------------------
MAX_REQUEST_BYTES=10485760
UPSTREAM_TIMEOUT=120s
SHUTDOWN_GRACE=25s

# --- Kebijakan Egress & Penjaga SSRF -------------------------------------------
# Penjaga SSRF secara default memblokir alamat IP privat dan loopback.
UPSTREAM_ALLOW_HTTP=false

# --- Retensi Data & Pembersihan Otomatis ---------------------------------------
REQUEST_LOG_RETENTION_DAYS=30
REQUEST_BODY_RETENTION_DAYS=7

# --- Jadwal Pekerja Latar Belakang (Worker) -----------------------------------
HEALTH_CHECK_INTERVAL=60s
USAGE_ROLLUP_INTERVAL=5m
