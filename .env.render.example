# ==============================================================================
# Route-X — Contoh Konfigurasi Environment Khusus Render
# ==============================================================================
# Gunakan file ini sebagai acuan saat mengisi Environment Variables di Render Dashboard.
# Jika Anda menggunakan Blueprint render.yaml, sebagian besar variabel (seperti
# DATABASE_URL, REDIS_URL, PORT) telah terisi secara otomatis, dan SESSION_SECRET
# serta METRICS_TOKEN dibuatkan oleh Render (generateValue).
# Daftar ini sinkron dengan env yang dibaca internal/config/config.go.
# Nilai <...> adalah placeholder — jangan pakai apa adanya.
# ==============================================================================

# Mode Operasional (Wajib production di Render)
APP_ENV=production
LOG_LEVEL=info

# Port internal (Render otomatis menyediakan PORT=10000)
PORT=10000

# URL Publik Aplikasi (Ganti dengan nama layanan Anda di Render)
# Wajib HTTPS pada mode production
PUBLIC_URL=https://route-x.onrender.com

# Basis Data PostgreSQL (Diisi otomatis oleh Render jika menggunakan Blueprint)
# Format: postgres://routex:PASSWORD@dpg-xxxx-a.singapore-postgres.render.com/routex_prod
DATABASE_URL=postgres://user:password@host:5432/routex_prod
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# Redis & Rate Limiter (Diisi otomatis oleh Render jika menggunakan Blueprint)
# Format: redis://red-xxxx:6379
REDIS_URL=redis://host:6379

# Kunci Kriptografi & Sesi
# Hasilkan nilai baru dengan menjalankan: bash scripts/ops/generate-secrets.sh
# SESSION_SECRET min 32 karakter; ENCRYPTION_KEY base64 tepat 32 byte
# (render.yaml menandainya sync:false — isi manual); API_KEY_PEPPER base64 min 32 byte.
SESSION_SECRET=<placeholder-hasilkan-sendiri>
ENCRYPTION_KEY=<placeholder-hasilkan-sendiri>
# ENCRYPTION_KEY_PREVIOUS: hanya selama masa tenggang rotasi ENCRYPTION_KEY
# (lihat docs/runbook-operasi.md §4). Kosongkan di luar masa rotasi.
ENCRYPTION_KEY_PREVIOUS=
API_KEY_PEPPER=<placeholder-hasilkan-sendiri>
# SESSION_TTL: masa berlaku sesi (kedaluwarsa geser), bawaan 12 jam,
# rentang sah 5m s/d 168h; batas mutlak sesi 7 hari selalu berlaku.
SESSION_TTL=

# Akun Administrator Awal (Dibuat otomatis saat pertama kali startup)
# INITIAL_ADMIN_PASSWORD wajib terisi agar admin pertama dibuat —
# TIDAK ada password default.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=<GANTI_DENGAN_PASSWORD_KUAT_PILIHAN_ANDA>

# Metrik Prometheus & Scraper Token
METRICS_TOKEN=<placeholder-min-32-karakter>
METRICS_ALLOW_LOOPBACK=false

# Kebijakan Pembatasan Laju (Rate Limiting)
# false = fail-open saat Redis tak terjangkau (permintaan tetap dilayani).
RATE_LIMIT_FAIL_CLOSED=false

# Proxy Tepercaya
# Kosongkan bila tidak yakin — jangan pernah 0.0.0.0/0 (semua klien bisa
# memalsukan X-Forwarded-For). Isi CIDR edge Render bila Anda memverifikasinya.
TRUSTED_PROXIES=

# Batas Waktu & Perilaku Upstream (opsional; kosong = bawaan kode)
# UPSTREAM_TIMEOUT bawaan 120s; READ_TIMEOUT 30s; WRITE_TIMEOUT 5m;
# SHUTDOWN_GRACE 25s. Makna 0 TIDAK seragam antar-knob — lihat .env.example.
UPSTREAM_TIMEOUT=
READ_TIMEOUT=
WRITE_TIMEOUT=
SHUTDOWN_GRACE=
# BUDGET_TIMEZONE: zona IANA batas kalender periode anggaran weekly/monthly
# (bawaan UTC). Nama tak sah membuat gateway menolak boot.
BUDGET_TIMEZONE=
# MAX_REQUEST_MIB: batas ukuran badan request klien (bawaan 10).
MAX_REQUEST_MIB=

# OAuth Upstream (Google Antigravity)
# render.yaml TIDAK mendeklarasikan variabel ini — tambahkan manual di
# Dashboard bila memakai integrasi Antigravity. Dibaca dari environment
# saja, tidak ada nilai tertanam di biner.
ANTIGRAVITY_CLIENT_SECRET=<placeholder-isi-bila-memakai-antigravity>

# Retensi & Interval (opsional; kosong = bawaan kode)
# REQUEST_LOG_RETENTION_DAYS=30, REQUEST_BODY_RETENTION_DAYS=7,
# AUDIT_LOG_RETENTION_DAYS=365, HEALTH_CHECK_INTERVAL=60s,
# USAGE_ROLLUP_INTERVAL=5m.
REQUEST_LOG_RETENTION_DAYS=
REQUEST_BODY_RETENTION_DAYS=
AUDIT_LOG_RETENTION_DAYS=
HEALTH_CHECK_INTERVAL=
USAGE_ROLLUP_INTERVAL=
