{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "port": 10808,
      "listen": "127.0.0.1",
      "protocol": "socks",
      "settings": {
        "auth": "password",
        "accounts": [{ "user": "routex", "pass": "<GANTI_PASSWORD_INI>" }],
        "udp": true
      }
    },
    {
      "tag": "http-in",
      "port": 10809,
      "listen": "127.0.0.1",
      "protocol": "http",
      "settings": {
        "accounts": [{ "user": "routex", "pass": "<GANTI_PASSWORD_INI>" }],
        "allowTransparent": false
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy-vless-reality",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "YOUR_REMOTE_NODE_IP_OR_DOMAIN",
            "port": 443,
            "users": [
              {
                "id": "YOUR_VLESS_CLIENT_UUID",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "fingerprint": "chrome",
          "serverName": "www.microsoft.com",
          "publicKey": "YOUR_REALITY_PUBLIC_KEY",
          "shortId": "YOUR_REALITY_SHORT_ID",
          "spiderX": ""
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {}
    }
  ]
}
